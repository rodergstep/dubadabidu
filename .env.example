# Copy to .env and fill in. This file is the human's ONLY credentials
# touchpoint (docs/AUTOPILOT.md). .env is git-ignored; never commit real keys.

# Translation endpoint key. Real key for DeepSeek/OpenAI; any non-empty
# string for local LM Studio/Ollama. The variable's NAME is whatever
# translation.api_key_env says (TRANSLATE_API_KEY in config.yaml).
TRANSLATE_API_KEY=

# RunPod API key — used by the M2 infra agent to provision/terminate pods.
# Create at https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# --- optional, research only -------------------------------------------------
# research.stress_mfa (FINDINGS §2.1h) needs the directory holding its MFA install
# (mfaenv/) and models (mfa_data/). Read from the shell environment by
# `python -m research.stress_mfa`, which does not load this file — export it there.
# DUB_MFA_SCRATCH=/path/to/mfa_scratch
