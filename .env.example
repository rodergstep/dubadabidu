# Copy to .env and fill in. This file is the human's ONLY credentials
# touchpoint (AUTOPILOT.md). .env is git-ignored; never commit real keys.

# Translation endpoint key. Real key for DeepSeek/OpenAI; any non-empty
# string for local LM Studio/Ollama.
TRANSLATE_API_KEY=

# RunPod API key — used by the M2 infra agent to provision/terminate pods.
# Create at https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=
